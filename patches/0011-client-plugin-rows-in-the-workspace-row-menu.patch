diff --git a/packages/client/ui-workspace/tests/rows.client.spec.tsx b/packages/client/ui-workspace/tests/rows.client.spec.tsx
index 6a32265a17..8b7b4cdc90 100644
--- a/packages/client/ui-workspace/tests/rows.client.spec.tsx
+++ b/packages/client/ui-workspace/tests/rows.client.spec.tsx
@@ -457,6 +457,27 @@ describe('workspace browser rows', () => {
     expect(screen.queryByRole('menu')).toBeNull()
   })
 
+  it('workspace row menu renders plugin rows after the shipped ones, with the row identity and open state', () => {
+    const group: GroupNode = {
+      key: 'project', workspaceId: wid('project'), cwd: '/projects/project', createdAt: 0, label: 'Project',
+      sessionCount: 0, expanded: false, containsCurrent: false, sessions: [],
+    }
+    const seen: unknown[] = []
+    const renderSlot = ((name: string, owner: unknown, options?: { hookContext?: readonly [boolean, (open: boolean) => void] }) => {
+      if (name !== 'sidebar.workspaces.workspace.menu.item') return null
+      seen.push(owner)
+      const close = options?.hookContext?.[1]
+      return <button type="button" role="menuitem" onClick={() => { close?.(false) }}>复制为工作区</button>
+    }) as never
+    render(<ProjectRowItem group={group} onToggle={vi.fn()} onCreate={vi.fn()} actions={{ rename: vi.fn(), delete: vi.fn() }}
+      renderSlot={renderSlot} t={t} />)
+    fireEvent.click(screen.getByRole('button', { name: '工作区“Project”的操作' }))
+    expect(screen.getAllByRole('menuitem').map(item => item.textContent)).toEqual(['重命名', '删除工作区', '复制为工作区'])
+    expect(seen.at(-1)).toEqual({ workspaceId: 'project', path: '/projects/project', title: 'Project' })
+    fireEvent.click(screen.getByRole('menuitem', { name: '复制为工作区' }))
+    expect(screen.queryByRole('menu')).toBeNull()
+  })
+
   it('workspace hover card shows its details and copies the full directory path', async () => {
     vi.useFakeTimers()
     const writeText = vi.fn(async () => {})
