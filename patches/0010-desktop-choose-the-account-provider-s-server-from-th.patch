+  // A provider exposing a live `serverOrigin` field lets members choose its server.
+  const serverEntry = async () => {
+    const settings = await invoke({ namespace: 'settings', method: 'describe', args: {} })
+    if (!record(settings) || !Array.isArray(settings.namespaces)) throw new Error('desktop welcome: missing settings namespaces')
+    const entry: unknown = settings.namespaces.find((item: unknown) => record(item) && record(item.value) && typeof item.value.serverOrigin === 'string')
+    if (!record(entry) || typeof entry.ns !== 'string' || typeof entry.revision !== 'number' || !record(entry.value)) return undefined
+    const current = entry.value.serverOrigin as string
+    const base = record(entry.base) && typeof entry.base.serverOrigin === 'string' ? entry.base.serverOrigin : current
+    const overridden = record(entry.user) && typeof entry.user.serverOrigin === 'string' && entry.user.serverOrigin !== base
+    return { ns: entry.ns, revision: entry.revision, server: { current, base, overridden } satisfies WelcomeServer }
+  }
   return {
     account,
     read,
+    async server() { return (await serverEntry())?.server },
+    async setServer(origin) {
+      try {
+        const entry = await serverEntry()
+        if (entry === undefined) return { ok: false }
+        const ops = origin === null ? [{ op: 'unset', path: ['serverOrigin'] }] : [{ op: 'set', path: ['serverOrigin'], value: origin }]
+        await invoke({ namespace: 'settings', method: 'mutate', args: { ns: entry.ns, ops, expectedRevision: entry.revision } })
+        return { ok: true }
+      } catch {
+        return { ok: false }
+      }
+    },
