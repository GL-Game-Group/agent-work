+/**
+ * The account provider's server setting: a live `serverOrigin` field some providers expose
+ * (the welcome window offers it only when one exists).
+ */
+export interface WelcomeServer {
+  /** Origin in effect for this profile. */
+  readonly current: string
+  /** Origin without the member's own choice. */
+  readonly base: string
+  /** Whether the member chose a server other than the base one. */
+  readonly overridden: boolean
+}
+
+/**
+ * Normalize a server the member typed: an https origin, or http on a loopback host for local services.
+ * @param value - typed address.
+ * @returns the bare origin, or undefined when it is not one.
+ */
+export function welcomeServerOrigin(value: string): string | undefined {
+  let url: URL
+  try { url = new URL(value.trim()) } catch { return undefined }
+  const loopback = ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)
+  if (url.protocol !== 'https:' && !(url.protocol === 'http:' && loopback)) return undefined
+  if (url.username !== '' || url.password !== '' || url.pathname !== '/' || url.search !== '' || url.hash !== '') return undefined
+  return url.origin
+}
+
 /** Credential writes return a safe outcome without exposing Host diagnostics. */
 export type WelcomeSaveResult = { readonly ok: true } | { readonly ok: false }
 
