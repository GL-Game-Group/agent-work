From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wuming <eva2show@gmail.com>
Date: Fri, 2 Oct 2026 08:17:43 +0800
Subject: [PATCH 07/11] client: brand marks and hero copy from brand modules

ui-brand-official reads product.ts: with a mark and a name it fills the sidebar brand slots with them instead of the official whale and wordmark. ui-conversation reads brand.ts for the empty hero's fallback mark, its headline, and whether it shows the preview badge. The shipped files keep the official presentation; a rebranded build replaces them.

diff --git a/packages/client/ui-brand-official/src/client/Brand.tsx b/packages/client/ui-brand-official/src/client/Brand.tsx
index 9ac6dd7ce2..7a6451de2b 100644
--- a/packages/client/ui-brand-official/src/client/Brand.tsx
+++ b/packages/client/ui-brand-official/src/client/Brand.tsx
@@ -1,5 +1,6 @@
 import { BrandWordmark, FishLogo } from '@deepseek-ai/dsh-client-ui-primitives'
 import type { SidebarBrandMarkOwnerProps } from '@deepseek-ai/dsh-client-ui-sidebar/client'
+import { brand } from './product.ts'
 
 /**
  * Render the official mark with the presentation requested by its host surface.
@@ -17,3 +18,20 @@ export function OfficialBrandMark({ size }: SidebarBrandMarkOwnerProps) {
 export function OfficialBrandName() {
   return <BrandWordmark includeMark={false} />
 }
+
+/**
+ * Render a rebranded build's mark from brand.ts.
+ * @param props - Host-supplied mark presentation.
+ * @returns the product mark as an image.
+ */
+export function ProductBrandMark({ size }: SidebarBrandMarkOwnerProps) {
+  return <img src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(brand.markSvg ?? '')}`} width={size} height={size} alt="" style={{ objectFit: 'contain' }} />
+}
+
+/**
+ * Render a rebranded build's name from brand.ts.
+ * @returns the product name set as the sidebar wordmark.
+ */
+export function ProductBrandName() {
+  return <span style={{ fontSize: 17, fontWeight: 600, letterSpacing: '0.01em', whiteSpace: 'nowrap' }}>{brand.productName}</span>
+}
diff --git a/packages/client/ui-brand-official/src/client/index.ts b/packages/client/ui-brand-official/src/client/index.ts
index 332a5f6007..21a5371a99 100644
--- a/packages/client/ui-brand-official/src/client/index.ts
+++ b/packages/client/ui-brand-official/src/client/index.ts
@@ -2,7 +2,8 @@
 import type { Context as ClientContext } from '@deepseek-ai/cordis'
 import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
 import type {} from '@deepseek-ai/dsh-client-ui-sidebar/client'
-import { OfficialBrandMark, OfficialBrandName } from './Brand.tsx'
+import { brand } from './product.ts'
+import { OfficialBrandMark, OfficialBrandName, ProductBrandMark, ProductBrandName } from './Brand.tsx'
 
 /** Required service: the UI slot registry. */
 export const inject = ['slots']
@@ -17,7 +18,9 @@ export function apply(ctx: ClientContext): void {
   if (process.env.DSH_CLIENT_BUILD_PROFILE !== 'official') return
   ctx.slots.inject('sidebar.brand.mark', () =>
     ctx.slots.inject('sidebar.brand.name', function* () {
-      yield ctx.slots.register({ name: 'sidebar.brand.mark' }, OfficialBrandMark)
-      yield ctx.slots.register({ name: 'sidebar.brand.name' }, OfficialBrandName)
+      // A rebranded build (brand.ts with a mark) shows its own mark and name.
+      const rebranded = brand.markSvg !== null && brand.productName !== null
+      yield ctx.slots.register({ name: 'sidebar.brand.mark' }, rebranded ? ProductBrandMark : OfficialBrandMark)
+      yield ctx.slots.register({ name: 'sidebar.brand.name' }, rebranded ? ProductBrandName : OfficialBrandName)
     }))
 }
diff --git a/packages/client/ui-brand-official/src/client/product.ts b/packages/client/ui-brand-official/src/client/product.ts
new file mode 100644
index 0000000000..756d778521
--- /dev/null
+++ b/packages/client/ui-brand-official/src/client/product.ts
@@ -0,0 +1,7 @@
+/** Product identity in the sidebar brand slots. A rebranded build replaces this file. */
+export const brand: {
+  /** Name beside the sidebar mark; null keeps the official wordmark. */
+  readonly productName: string | null
+  /** SVG markup of the sidebar mark; null keeps the official whale. */
+  readonly markSvg: string | null
+} = { productName: null, markSvg: null }
