From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wuming <eva2show@gmail.com>
Date: Fri, 2 Oct 2026 03:16:09 +0800
Subject: [PATCH 03/11] desktop: run beside other Desktop builds

DSH_DESKTOP_DEFAULT_HOME and DSH_DESKTOP_HOST_PORT in the platform dotenv file are recorded in the application manifest. The packaged main process applies them before any module resolves DSH_HOME or spawns the Host, unless the person running the app set DSH_HOME or DSH_DESKTOP_HOST_PORT. The macOS dsh CLI launcher reads the same home from Info.plist.

A configured DSH_DESKTOP_PRODUCT_NAME also names the Electron userData directory, set before the single-instance claim. Without it every build used ~/Library/Application Support/@deepseek-ai/dsh-desktop, so a second differently named Desktop found the first one's lock and exited.

diff --git a/apps/desktop-host/src/host-port.ts b/apps/desktop-host/src/host-port.ts
new file mode 100644
index 0000000000..67a40e06ca
--- /dev/null
+++ b/apps/desktop-host/src/host-port.ts
@@ -0,0 +1,21 @@
+/** Listen port selection for the Desktop Host's Web application. */
+
+/** Port used when neither the packaged build nor the person running it chooses one. */
+const DEFAULT_DESKTOP_HOST_PORT = 19387
+
+/**
+ * Resolve the Host listen port from `DSH_DESKTOP_HOST_PORT`, which the Desktop
+ * main process sets from the packaged build's default unless the person
+ * running it already chose a value.
+ * @param env - Host process environment.
+ * @returns the port as the `--port` argument value.
+ * @throws when the variable is set to anything other than an integer from 1024 to 65535.
+ */
+export function resolveDesktopHostPort(env: NodeJS.ProcessEnv): string {
+  const configured = env.DSH_DESKTOP_HOST_PORT?.trim() ?? ''
+  if (configured === '') return String(DEFAULT_DESKTOP_HOST_PORT)
+  if (!/^[1-9][0-9]*$/u.test(configured) || Number(configured) < 1024 || Number(configured) > 65535) {
+    throw new Error('dsh desktop host: DSH_DESKTOP_HOST_PORT must be an integer from 1024 to 65535')
+  }
+  return configured
+}
