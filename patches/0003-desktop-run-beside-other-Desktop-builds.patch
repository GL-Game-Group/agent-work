+/**
+ * Resolve the installed application's runtime defaults recorded at packaging time.
+ * The home and port apply only when the person running the application has not
+ * set `DSH_HOME` or `DSH_DESKTOP_HOST_PORT`.
+ * A configured `DSH_DESKTOP_PRODUCT_NAME` also names the Electron userData
+ * directory, which holds the single-instance lock, so differently named builds
+ * run side by side; without it the directory keeps Electron's default name.
+ * @param {NodeJS.ProcessEnv} env - Packaging environment.
+ * @returns {{ defaultHome?: string, hostPort?: number, userDataName?: string }} Harness home (absolute or `~/`-relative), Host listen port, and userData directory name; each omitted when unset.
+ */
+export function resolveDesktopRuntimeDefaults(env) {
+  const defaults = {}
+  const productName = env.DSH_DESKTOP_PRODUCT_NAME
+  if (productName !== undefined && productName !== '') {
+    if (/[/\\:]/u.test(productName) || productName.trim() !== productName || productName.startsWith('.')) {
+      throw new Error('desktop release environment: DSH_DESKTOP_PRODUCT_NAME must be usable as a directory name')
+    }
+    defaults.userDataName = productName
+  }
+  const home = env.DSH_DESKTOP_DEFAULT_HOME
+  if (home !== undefined && home !== '') {
+    if (!home.startsWith('/') && !home.startsWith('~/')) {
+      throw new Error('desktop release environment: DSH_DESKTOP_DEFAULT_HOME must be an absolute path or start with ~/')
+    }
+    defaults.defaultHome = home
+  }
+  const port = env.DSH_DESKTOP_HOST_PORT
+  if (port !== undefined && port !== '') {
+    if (!/^[1-9][0-9]*$/u.test(port) || Number(port) < 1024 || Number(port) > 65535) {
+      throw new Error('desktop release environment: DSH_DESKTOP_HOST_PORT must be an integer from 1024 to 65535')
+    }
+    defaults.hostPort = Number(port)
+  }
+  return defaults
+}
+
