@@ -0,0 +1,48 @@
+/** Runtime defaults that a packaged Desktop build records in its application manifest. */
+
+import { expandHomePath } from '@deepseek-ai/dsh-home-paths'
+
+/**
+ * Read the manifest's `dshDesktopUserDataName`, the directory under the
+ * platform application-data directory that holds Electron userData and the
+ * single-instance lock.
+ * @param manifest - Parsed packaged application manifest.
+ * @returns the directory name, or undefined when the build keeps Electron's default.
+ * @throws when the field is present but not a single path segment.
+ */
+export function desktopUserDataName(manifest: unknown): string | undefined {
+  if (typeof manifest !== 'object' || manifest === null) throw new Error('desktop runtime defaults: invalid application manifest')
+  if (!('dshDesktopUserDataName' in manifest)) return undefined
+  const name = manifest.dshDesktopUserDataName
+  if (typeof name !== 'string' || name === '' || /[/\\:]/u.test(name) || name.trim() !== name || name.startsWith('.')) {
+    throw new Error('desktop runtime defaults: dshDesktopUserDataName must be a single directory name')
+  }
+  return name
+}
+
+/**
+ * Apply the manifest's `dshDesktopDefaultHome` and `dshDesktopHostPort` to the
+ * environment the Desktop main process and its Host share. A value applies only
+ * when `DSH_HOME` or `DSH_DESKTOP_HOST_PORT` is unset or blank, so a person's
+ * own setting always wins. Absent manifest fields leave the environment as is.
+ * @param manifest - Parsed packaged application manifest.
+ * @param env - Environment to update in place.
+ * @throws when a present field has the wrong type or range.
+ */
+export function applyDesktopRuntimeDefaults(manifest: unknown, env: NodeJS.ProcessEnv): void {
+  if (typeof manifest !== 'object' || manifest === null) throw new Error('desktop runtime defaults: invalid application manifest')
+  if ('dshDesktopDefaultHome' in manifest) {
+    const home = manifest.dshDesktopDefaultHome
+    if (typeof home !== 'string' || (!home.startsWith('/') && !home.startsWith('~/'))) {
+      throw new Error('desktop runtime defaults: dshDesktopDefaultHome must be an absolute or ~/ path')
+    }
+    if ((env.DSH_HOME ?? '').trim() === '') env.DSH_HOME = expandHomePath(home)
+  }
+  if ('dshDesktopHostPort' in manifest) {
+    const port = manifest.dshDesktopHostPort
+    if (typeof port !== 'number' || !Number.isInteger(port) || port < 1024 || port > 65535) {
+      throw new Error('desktop runtime defaults: dshDesktopHostPort must be an integer from 1024 to 65535')
+    }
+    if ((env.DSH_DESKTOP_HOST_PORT ?? '').trim() === '') env.DSH_DESKTOP_HOST_PORT = String(port)
+  }
+}
