diff --git a/apps/desktop-host/tests/host-port.spec.ts b/apps/desktop-host/tests/host-port.spec.ts
new file mode 100644
index 0000000000..60ca0d32dd
--- /dev/null
+++ b/apps/desktop-host/tests/host-port.spec.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest'
+import { resolveDesktopHostPort } from '../src/host-port.ts'
+
+describe('resolveDesktopHostPort', () => {
+  it('uses 19387 when DSH_DESKTOP_HOST_PORT is unset or blank', () => {
+    expect(resolveDesktopHostPort({})).toBe('19387')
+    expect(resolveDesktopHostPort({ DSH_DESKTOP_HOST_PORT: ' ' })).toBe('19387')
+  })
+
+  it('uses a configured port', () => {
+    expect(resolveDesktopHostPort({ DSH_DESKTOP_HOST_PORT: '19487' })).toBe('19487')
+  })
+
+  it('rejects ports outside 1024 to 65535 and non-integers', () => {
+    for (const value of ['80', '65536', '19487.5', 'abc', '019487']) {
+      expect(() => resolveDesktopHostPort({ DSH_DESKTOP_HOST_PORT: value })).toThrow(/DSH_DESKTOP_HOST_PORT/u)
+    }
+  })
+})
