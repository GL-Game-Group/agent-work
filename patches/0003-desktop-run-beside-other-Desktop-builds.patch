diff --git a/apps/desktop/tests/runtime-defaults.spec.ts b/apps/desktop/tests/runtime-defaults.spec.ts
new file mode 100644
index 0000000000..330d1c5477
--- /dev/null
+++ b/apps/desktop/tests/runtime-defaults.spec.ts
@@ -0,0 +1,47 @@
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { applyDesktopRuntimeDefaults, desktopUserDataName } from '../src/runtime-defaults.ts'
+
+describe('applyDesktopRuntimeDefaults', () => {
+  it('sets the Harness home and Host port when the person has not chosen them', () => {
+    const env: NodeJS.ProcessEnv = { DSH_HOME: '  ' }
+    applyDesktopRuntimeDefaults({ dshDesktopDefaultHome: '~/.agent-work', dshDesktopHostPort: 19487 }, env)
+    expect(env).toEqual({ DSH_HOME: join(homedir(), '.agent-work'), DSH_DESKTOP_HOST_PORT: '19487' })
+  })
+
+  it('keeps values the person already set', () => {
+    const env: NodeJS.ProcessEnv = { DSH_HOME: '/srv/dsh', DSH_DESKTOP_HOST_PORT: '20000' }
+    applyDesktopRuntimeDefaults({ dshDesktopDefaultHome: '/opt/team', dshDesktopHostPort: 19487 }, env)
+    expect(env).toEqual({ DSH_HOME: '/srv/dsh', DSH_DESKTOP_HOST_PORT: '20000' })
+  })
+
+  it('leaves the environment unchanged for a manifest without defaults', () => {
+    const env: NodeJS.ProcessEnv = {}
+    applyDesktopRuntimeDefaults({ name: '@deepseek-ai/dsh-desktop' }, env)
+    expect(env).toEqual({})
+  })
+
+  it('rejects malformed manifest fields', () => {
+    expect(() => applyDesktopRuntimeDefaults({ dshDesktopDefaultHome: 'relative/home' }, {})).toThrow(/dshDesktopDefaultHome/u)
+    expect(() => applyDesktopRuntimeDefaults({ dshDesktopHostPort: '19487' }, {})).toThrow(/dshDesktopHostPort/u)
+    expect(() => applyDesktopRuntimeDefaults({ dshDesktopHostPort: 80 }, {})).toThrow(/dshDesktopHostPort/u)
+    expect(() => applyDesktopRuntimeDefaults(null, {})).toThrow(/manifest/u)
+  })
+})
+
+describe('desktopUserDataName', () => {
+  it('returns the packaged userData directory name', () => {
+    expect(desktopUserDataName({ dshDesktopUserDataName: 'Team App' })).toBe('Team App')
+  })
+
+  it('keeps Electron\'s default when the manifest names none', () => {
+    expect(desktopUserDataName({ name: '@deepseek-ai/dsh-desktop' })).toBeUndefined()
+  })
+
+  it('rejects names that are not a single directory', () => {
+    for (const name of ['', 'a/b', 'a\\b', '..', ' Team', 42]) {
+      expect(() => desktopUserDataName({ dshDesktopUserDataName: name })).toThrow(/dshDesktopUserDataName/u)
+    }
+  })
+})
