diff --git a/apps/desktop/src/packaged-runtime-defaults.ts b/apps/desktop/src/packaged-runtime-defaults.ts
new file mode 100644
index 0000000000..318aabd7dc
--- /dev/null
+++ b/apps/desktop/src/packaged-runtime-defaults.ts
@@ -0,0 +1,19 @@
+/**
+ * Apply a packaged build's runtime defaults before any other main-process module
+ * resolves the Harness home, claims the single-instance lock, or spawns the Host.
+ * `main.ts` imports this module first; development launches keep their
+ * launcher-owned environment and `--user-data-dir`.
+ */
+
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { app } from 'electron'
+import { applyDesktopRuntimeDefaults, desktopUserDataName } from './runtime-defaults.ts'
+
+if (app.isPackaged) {
+  const manifest: unknown = JSON.parse(readFileSync(join(app.getAppPath(), 'package.json'), 'utf8'))
+  applyDesktopRuntimeDefaults(manifest, process.env)
+  // Must precede the single-instance claim, which locks the userData directory.
+  const userDataName = desktopUserDataName(manifest)
+  if (userDataName !== undefined) app.setPath('userData', join(app.getPath('appData'), userDataName))
+}
