From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wuming <eva2show@gmail.com>
Date: Sun, 4 Oct 2026 06:56:25 +0800
Subject: [PATCH 08/11] desktop: unpack preinstalled bundles' bin/ executables
 from ASAR


diff --git a/apps/desktop/scripts/electron-builder-config.mjs b/apps/desktop/scripts/electron-builder-config.mjs
index 2139bc76e6..bacbcbdd66 100644
--- a/apps/desktop/scripts/electron-builder-config.mjs
+++ b/apps/desktop/scripts/electron-builder-config.mjs
@@ -74,7 +74,10 @@ export function createElectronBuilderConfig(
   let dshDestination
   let windowsCode = []
   const unpack = ['**/*.{node,dylib,dll,so,exe}', '**/*.so.*', '**/spawn-helper', '**/@vscode/ripgrep-*/bin/rg',
-    `**/node_modules/@deepseek-ai/libreoffice-kit-${resolvedPlatform}-${resolvedArch}/**/*`]
+    `**/node_modules/@deepseek-ai/libreoffice-kit-${resolvedPlatform}-${resolvedArch}/**/*`,
+    // Executables preinstalled bundles ship in bin/ (e.g. a helper without a file extension):
+    // outside ASAR they can be spawned, and the runtime signing pass covers them.
+    ...(runtimeDefaults.defaultBundles ?? []).map(name => `**/node_modules/${name}/bin/**/*`)]
   const windowsSigner = packagesWindows && !unsigned
     ? createWindowsTokenSigner({
         certificateFile: env.DSH_DESKTOP_WINDOWS_CER_FILE,
