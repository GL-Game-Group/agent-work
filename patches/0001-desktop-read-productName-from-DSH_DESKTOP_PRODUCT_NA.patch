+/**
+ * Resolve the installed application's name shared by every platform target.
+ * electron-builder derives the bundle and executable names from it.
+ * @param {NodeJS.ProcessEnv} env - Packaging environment.
+ * @returns {string} Product name; `DeepSeek Harness` when the setting is absent or empty.
+ */
+export function resolveDesktopProductName(env) {
+  return env.DSH_DESKTOP_PRODUCT_NAME || 'DeepSeek Harness'
+}
