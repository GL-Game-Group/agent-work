+/** The shipped Web bundles, then the bundles this build preinstalls. */
+function desktopBundles(): string[] {
+  return [...WEB_PROFILE.bundles, ...desktopDefaultBundles()]
+}
+
+/**
+ * Select preinstalled bundles a profile lacks. They carry plugins the build requires
+ * (such as its account provider), so a profile created before them, or one that
+ * switched them off, gets them back on the next start.
+ */
+function selectDesktopDefaultBundles(projectDir: string): void {
+  const required = desktopDefaultBundles()
+  if (required.length === 0) return
+  const manifest = readProfileManifest('dsh', projectDir)
+  const selected = manifest.dsh?.profile?.bundles ?? []
+  const missing = required.filter(name => !selected.includes(name))
+  if (missing.length === 0) return
+  writeProfileManifest(projectDir, {
+    ...manifest,
+    dsh: { ...manifest.dsh, profile: { ...manifest.dsh?.profile, bundles: [...selected, ...missing] } },
+  })
+}
