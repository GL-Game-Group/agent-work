+/**
+ * Resolve the bundle packages a build preinstalls: comma-separated directories,
+ * relative to the repository root, each holding a package that declares `dsh.bundle`.
+ * Their tarballs join the Desktop package set, and new profiles select them after
+ * the shipped Web bundles.
+ * @param {NodeJS.ProcessEnv} env - Packaging environment.
+ * @returns {{ dir: string, name: string }[]} Absolute package directory and package name, in configured order.
+ */
+export function resolveDesktopExtraBundles(env) {
+  const value = env[EXTRA_BUNDLE_DIRS_ENV]?.trim() ?? ''
+  if (value === '') return []
+  const bundles = value.split(',').map(entry => entry.trim()).filter(entry => entry !== '').map((entry) => {
+    const dir = resolve(REPOSITORY_ROOT, entry)
+    let manifest
+    try { manifest = JSON.parse(readFileSync(resolve(dir, 'package.json'), 'utf8')) } catch (error) {
+      throw new Error(`desktop release environment: ${EXTRA_BUNDLE_DIRS_ENV} entry ${entry} has no readable package.json: ${String(error)}`)
+    }
+    if (typeof manifest.name !== 'string' || manifest.name === '' || typeof manifest.dsh?.bundle !== 'object') {
+      throw new Error(`desktop release environment: ${EXTRA_BUNDLE_DIRS_ENV} entry ${entry} is not a dsh bundle package`)
+    }
+    return { dir, name: manifest.name }
+  })
+  if (new Set(bundles.map(bundle => bundle.name)).size !== bundles.length) {
+    throw new Error(`desktop release environment: ${EXTRA_BUNDLE_DIRS_ENV} lists a bundle twice`)
+  }
+  return bundles
+}
