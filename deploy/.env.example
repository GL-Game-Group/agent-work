# Copy to deploy/.env on the server (chmod 600). Never commit the copy.
# Fixed settings (origin, ports, database path, frps address) live in compose.yml.

# GitHub OAuth App for production; callback URL:
#   https://agent.glgwork.com/agent-work/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=GL-Game-Group

# Seals API keys and secret config in the database (openssl rand -base64 32).
# Back it up together with the database: without it the stored keys cannot be read.
AGENT_WORK_SECRET_KEY=

# The path frps calls the company service back on (openssl rand -hex 24).
AGENT_WORK_FRP_PLUGIN_SECRET=
# Tunnel domains must resolve here.
AGENT_WORK_TUNNEL_IP=47.236.206.86

# The infrastructure frps on this host (/etc/frp/frps.toml auth.token): frpc-ingress
# registers agent.glgwork.com, frp.glgwork.com and *.glwork.app with it.
FRP_INGRESS_TOKEN=
# Certificates: Cloudflare origin certificates in deploy/certs/ (see README), no ACME.
