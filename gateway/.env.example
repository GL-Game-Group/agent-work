# Copy to gateway/.env (Git ignored) for a local run with real GitHub sign-in:
#   pnpm --filter @agent-work/gateway start:local
AGENT_WORK_PUBLIC_ORIGIN=http://127.0.0.1:8787
# Name shown in the admin console (http://127.0.0.1:8787/agent-work/admin).
AGENT_WORK_PRODUCT_NAME=GL Work
AGENT_WORK_DB=./data/gateway.db

# GitHub OAuth App of GL-Game-Group. Its "Authorization callback URL" must be
#   http://127.0.0.1:8787/agent-work/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=GL-Game-Group

# Master key sealing vendor API keys and secret public config in the database.
# Generate once (openssl rand -base64 32) and back it up with the database:
# without it the stored keys cannot be read.
AGENT_WORK_SECRET_KEY=

# Optional, from before keys were managed in the admin console: on first start
# this key becomes the first DeepSeek key and DeepSeek is enabled for every
# existing member. Afterwards manage keys in the console and remove it here.
DEEPSEEK_API_KEY=
# DEEPSEEK_UPSTREAM=https://api.deepseek.com/anthropic

# 内网穿透（frp）。不设 AGENT_WORK_FRPS_ADDR 就不开隧道。
# GL Work 的 frpc 连接的地址（经 Traefik 的 443 用 wss；直连 frps 的 bindPort 用 tcp）
AGENT_WORK_FRPS_ADDR=
AGENT_WORK_FRPS_PORT=443
AGENT_WORK_FRPS_PROTOCOL=wss
# frps 回调公司服务的路径密钥（至少 24 个字符）：frps.toml 的 httpPlugins.path = "/agent-work/frp/<这个值>"
# 生成：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AGENT_WORK_FRP_PLUGIN_SECRET=
# 服务器公网 IP：检测隧道域名时，泛解析必须指向它
AGENT_WORK_TUNNEL_IP=
# 手机远程：公司服务经 frps 的 vhostHTTPPort 中转手机的请求（只在内网可达，Traefik 不转发 *.remote.internal）。不设就不开手机远程
AGENT_WORK_FRPS_VHOST=
